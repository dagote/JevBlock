{
  "manifest_version": 3,
  "name": "Adgate",
  "version": "0.0.3",
  "description": "0.0.3 \u2014 annotate; per-element jev calls; skip if prefix too long",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://192.168.0.119:8770/*",
    "http://127.0.0.1:8770/*",
    "http://localhost:8770/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Adgate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "logger.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}
