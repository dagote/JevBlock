{
  "manifest_version": 3,
  "name": "Adgate",
  "version": "0.0.4",
  "description": "0.0.4 — review mode; remove ads and empty parents; decision log",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.dagote.ai/*",
    "https://dagote.ai/*",
    "http://192.168.0.119:8770/*",
    "http://127.0.0.1:8770/*",
    "http://localhost:8770/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Adgate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_hosts",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "empty-parent.js",
        "decision-log.js",
        "logger.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}
