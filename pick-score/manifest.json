{
  "manifest_version": 3,
  "name": "JEV Pick Score",
  "version": "0.1.0",
  "description": "Pick one DOM element and score it with Dagote JEV. Classify only — does not hide anything.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.dagote.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "JEV Pick Score",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["collect.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}
